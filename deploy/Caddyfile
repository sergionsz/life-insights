# /etc/caddy/Caddyfile
#
# Caddy obtains and renews a Let's Encrypt certificate on its own. For that it needs recuer.de to
# resolve to this machine and ports 80 and 443 to reach it; Oracle Cloud blocks both in two
# separate places by default. See deploy/README.md.

{
	# Where Let's Encrypt sends expiry and problem notices. Without it, a certificate that quietly
	# stops renewing gives no warning until sync starts failing.
	email you@example.com
}

recuer.de {
	encode zstd gzip

	# The phone is the only client and it speaks to a handful of paths. Anything else that finds
	# the host gets nothing to work with.
	handle /v1/sync/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle /health {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		respond "Not found" 404
	}

	log {
		# Paths and statuses only. Request bodies here would be mood and sleep history written into
		# a log file that outlives any decision to keep it.
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}
