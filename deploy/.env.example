# Copy to deploy/.env on the server and fill in. Never commit the real file.
#
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env

SYNC_DOMAIN=recuer.de

# Both of these: openssl rand -base64 32
# SYNC_TOKEN is what you paste into the app's Settings screen. It is the only thing standing
# between the internet and your data, so generate it, do not invent it.
SYNC_TOKEN=
POSTGRES_PASSWORD=

# Where Let's Encrypt sends expiry warnings. Optional but worth setting: without it, a certificate
# that quietly stops renewing gives you no warning until sync starts failing.
ACME_EMAIL=
