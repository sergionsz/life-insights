<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Only ever used to talk to the sync server the user configures in Settings. Sync is off by
      default and there is no other network code in the app: no analytics, no crash reporting, no
      remote config.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Usage access is a special permission. It cannot be requested with a runtime dialog; the user
      has to grant it in Settings, and the app detects the result via AppOps. Declaring it here is
      what makes the app appear in that Settings list at all.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Needed to list launchable apps for the "which apps distract you" picker. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".LifeInsightsApp"
        android:allowBackup="false"
        android:label="Life Insights"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeInsights">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Life Insights"
            android:theme="@style/Theme.LifeInsights">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
